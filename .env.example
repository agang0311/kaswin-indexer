# Kaswin Event Indexer 环境变量配置示例

# 1. 节点配置（二选一或留空）
# 留空：自动使用 Kaspa TN10 Seed + Resolver 探测双节点热备池（默认推荐）
KASWIN_NODE_URL=

# 或指定单个固定 wRPC 节点（例如自建或公开节点，必须已同步且开启 --utxoindex）
# KASWIN_NODE_URL=wss://la.cd311.cn/wrpc/borsh

# 或指定双节点热备列表（逗号分隔）
# KASWIN_NODE_URLS=wss://node1/...,wss://node2/...

# 2. Registry 地址配置（可选，逗号分隔，留空使用默认官方 TN10 Registry）
# KASWIN_REGISTRY_ADDRESSES=kaspatest:qztrjpfpuf6g9jw76e6ay909z43hndpv5maqkker6ur4enz7llarsh82ezggl

# 3. 跨域配置（可选，默认 '*' 允许全部前端跨域，可填具体域名如 https://my-dapp.com，或填 none 禁用）
# KASWIN_CORS_ORIGIN=*
